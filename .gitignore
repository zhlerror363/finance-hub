# 运行时数据 & 敏感文件（不入库：真实账本、演示库、AI key）
data/*
!data/.gitkeep

# 测试运行时生成的 SQLite 示例库（如 finance-report/tests/sample.db）：属运行产物、每次跑测试都会重建，
# 不入库。同目录下的 out-*.html 是已入库的参考输出，不受本规则影响。
finance-report/tests/*.db

# 依赖（本项目零依赖，为保险忽略）
node_modules/

# 设计文档（主人视为不可对外分享的资产，不入库）
docs/

# 便携版打包产物（体积大，不入库）
dist/

# 运行时文件
server.log
server.pid
logs/

# 数据库快照（VACUUM INTO 产物）：属运行产物、由打包器与备份链路重新生成，不入库。
# 注意：它同时是 workspace-backup 的一个备份源（finance-hub-ledger-snapshot），忽略不影响备份。
data-snapshots/

# 系统
.DS_Store
Thumbs.db
